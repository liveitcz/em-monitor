# =============================================================
#  Energy Monitor — .env.example
#  Copy this file to .env and set your path
#  Run: bash setup.sh  (creates .env automatically)
# =============================================================

# Absolute path to this directory — change to match your system
# Examples:
#   Debian:   EM_ROOT=/etc/docker/em
#   Synology: EM_ROOT=/volume2/docker/em_v01
EM_ROOT=/etc/docker/em
